---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  includeAnalytics?: boolean;
}

const { title, description, noindex = false, includeAnalytics = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <style is:global>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; max-width: 800px; margin: 0 auto; padding: 20px; color: #333; }
      h1 { border-bottom: 1px solid #eee; padding-bottom: 10px; }
      .section { margin-bottom: 30px; }
      a { color: #007AFF; text-decoration: none; }
    </style>
    {includeAnalytics && (
      <>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-QSMNQ8CKJG"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-QSMNQ8CKJG');
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
