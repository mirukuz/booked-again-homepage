---
import Layout from '../layouts/Layout.astro';
import DownloadButtons from '../components/DownloadButtons.astro';
---

<Layout title="BookedAgain — Share Books, Build Community" description="BookedAgain turns your idle books into a living community resource. Scan, swap, and track books with neighbors. Download on iOS and Android." fullWidth={true}>

<style>
  /* Reset & Base */
  * { box-sizing: border-box; margin: 0; padding: 0; }

  /* Navbar */
  .navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 48px;
    background: transparent;
    transition: background 0.3s, box-shadow 0.3s;
  }
  .navbar.scrolled {
    background: #FFF8F0;
    box-shadow: 0 2px 12px rgba(61,43,31,0.1);
  }
  .navbar-logo {
    font-size: 1.4rem;
    font-weight: 800;
    color: #3D2B1F;
    letter-spacing: -0.5px;
    text-decoration: none;
  }
  .navbar-links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
  }
  .navbar-links a {
    color: #3D2B1F;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  .navbar-links a:hover { opacity: 1; }
  .btn-nav {
    background: #3D2B1F;
    color: #FFF8F0 !important;
    padding: 10px 22px;
    border-radius: 100px;
    opacity: 1 !important;
    font-weight: 600 !important;
    transition: background 0.2s !important;
  }
  .btn-nav:hover { background: #C9583A !important; }

  /* Hero */
  .hero {
    min-height: 100vh;
    background: linear-gradient(160deg, #E8904A 0%, #C9583A 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 24px 160px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 80px;
    background: #FFF8F0;
    clip-path: ellipse(55% 100% at 50% 100%);
  }
  .hero-img {
    width: min(620px, 90%);
    border-radius: 24px;
    box-shadow: 0 24px 80px rgba(61,43,31,0.35);
    margin-bottom: 40px;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    color: #FFF8F0;
    line-height: 1.15;
    max-width: 700px;
    margin-bottom: 20px;
    letter-spacing: -1px;
    border: none;
    padding: 0;
  }
  .hero p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: rgba(255,248,240,0.9);
    max-width: 560px;
    margin-bottom: 40px;
    line-height: 1.6;
  }
  /* Section common */
  .section-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 900;
    letter-spacing: -0.5px;
    line-height: 1.15;
    margin-bottom: 16px;
  }
  .section-subtitle {
    font-size: 1.1rem;
    opacity: 0.7;
    max-width: 560px;
    line-height: 1.6;
  }
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Features */
  .features {
    background: #FFF8F0;
    padding: 100px 24px;
    text-align: center;
  }
  .features .section-label { color: #C9583A; }
  .features .section-title { color: #3D2B1F; }
  .features .section-subtitle { color: #3D2B1F; margin: 0 auto 60px; }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 60px;
  }
  .feature-card {
    background: #fff;
    border-radius: 20px;
    padding: 36px 28px;
    text-align: left;
    box-shadow: 0 2px 16px rgba(61,43,31,0.07);
    transition: transform 0.2s, box-shadow 0.2s;
    border: 1px solid rgba(232,144,74,0.15);
  }
  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(61,43,31,0.13);
  }
  .feature-icon {
    font-size: 2.2rem;
    margin-bottom: 16px;
    display: block;
  }
  .feature-card h3 {
    font-size: 1.1rem;
    font-weight: 800;
    color: #3D2B1F;
    margin-bottom: 10px;
  }
  .feature-card p {
    font-size: 0.95rem;
    color: #6B5344;
    line-height: 1.6;
  }

  /* How it works */
  .how-it-works {
    background: #FAF0E6;
    padding: 100px 24px;
    text-align: center;
  }
  .how-it-works .section-label { color: #C9583A; }
  .how-it-works .section-title { color: #3D2B1F; }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0;
    margin-top: 60px;
    position: relative;
  }
  .steps::before {
    content: '';
    position: absolute;
    top: 36px;
    left: 10%;
    right: 10%;
    height: 2px;
    background: linear-gradient(90deg, #E8904A, #C9583A);
    z-index: 0;
  }
  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 12px;
    position: relative;
    z-index: 1;
  }
  .step-number {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, #E8904A, #C9583A);
    color: #FFF8F0;
    font-size: 1.4rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 4px 16px rgba(201,88,58,0.35);
  }
  .step h3 {
    font-size: 1rem;
    font-weight: 800;
    color: #3D2B1F;
    margin-bottom: 8px;
  }
  .step p {
    font-size: 0.85rem;
    color: #6B5344;
    line-height: 1.5;
    max-width: 160px;
  }

  /* Download CTA */
  .download-cta {
    background: #3D6B4F;
    padding: 100px 24px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .download-cta::before {
    content: '📚';
    position: absolute;
    font-size: 200px;
    opacity: 0.05;
    top: -20px;
    left: -40px;
    pointer-events: none;
  }
  .download-cta::after {
    content: '🌿';
    position: absolute;
    font-size: 200px;
    opacity: 0.05;
    bottom: -40px;
    right: -20px;
    pointer-events: none;
  }
  .download-cta .section-label { color: #A8D5B5; }
  .download-cta .section-title { color: #FFF8F0; }
  .download-cta .section-subtitle { color: rgba(255,248,240,0.75); margin: 0 auto 40px; }
  :global(.download-cta .btn-appstore) { background: #FFF8F0; color: #3D2B1F; }
  :global(.download-cta .btn-googleplay) { background: rgba(255,248,240,0.15); color: #FFF8F0; border: 2px solid rgba(255,248,240,0.4); }

  /* Support */
  .support {
    background: #FFF8F0;
    padding: 80px 24px;
  }
  .support .section-title { color: #3D2B1F; margin-bottom: 48px; }
  .support-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .support-card {
    background: #fff;
    border-radius: 16px;
    padding: 32px;
    border: 1px solid rgba(232,144,74,0.15);
    box-shadow: 0 2px 12px rgba(61,43,31,0.05);
  }
  .support-card h3 {
    font-size: 1rem;
    font-weight: 800;
    color: #3D2B1F;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .support-card p {
    font-size: 0.95rem;
    color: #6B5344;
    line-height: 1.6;
  }
  .support-card a {
    color: #C9583A;
    text-decoration: none;
    font-weight: 600;
  }
  .support-card a:hover { text-decoration: underline; }

  /* Footer */
  .footer {
    background: #3D2B1F;
    color: rgba(255,248,240,0.6);
    text-align: center;
    padding: 32px 24px;
    font-size: 0.9rem;
  }
  .footer a { color: rgba(255,248,240,0.6); text-decoration: none; }
  .footer a:hover { color: #FFF8F0; }
  .footer-inner { display: flex; align-items: center; justify-content: center; gap: 24px; flex-wrap: wrap; }

  /* Mobile */
  @media (max-width: 768px) {
    .navbar { padding: 14px 20px; }
    .navbar-links { gap: 16px; }
    .navbar-links li:not(:last-child) { display: none; }
    .hero { padding: 100px 20px 140px; }
    .steps { grid-template-columns: 1fr; gap: 32px; }
    .steps::before { display: none; }
    .step { flex-direction: row; text-align: left; gap: 20px; }
    .step-number { flex-shrink: 0; width: 52px; height: 52px; font-size: 1.1rem; }
    .step p { max-width: none; }
    .features-grid { grid-template-columns: 1fr; }
  }
</style>

<!-- Navbar -->
<nav class="navbar" id="navbar">
  <a href="#" class="navbar-logo">BookedAgain</a>
  <ul class="navbar-links">
    <li><a href="#features">Features</a></li>
    <li><a href="#how-it-works">How It Works</a></li>
    <li><a href="#support">Support</a></li>
    <li><a href="#download" class="btn-nav">Download</a></li>
  </ul>
</nav>

<script is:inline>
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 40);
  });
</script>

<!-- Hero -->
<section class="hero">
  <img src="/theme.png" alt="A wombat and koala happily exchanging a book in a forest" class="hero-img" />
  <h1>Books are meant to be read, not to gather dust.</h1>
  <p>BookedAgain turns your static library into a living, breathing community resource. Every book has a lifecycle beyond a single owner.</p>
  <DownloadButtons />
</section>

<!-- Features -->
<section class="features" id="features">
  <div class="container">
    <div class="section-label">Why BookedAgain</div>
    <h2 class="section-title">A better way to share books</h2>
    <p class="section-subtitle">We believe every book has a lifecycle beyond a single owner. By circulating your idle books, you help build a trusted, transparent, and sustainable reading network.</p>
    <div class="features-grid">
      <div class="feature-card">
        <span class="feature-icon">📷</span>
        <h3>Effortless Uploads</h3>
        <p>No need to type out long details. Simply scan the book's ISBN barcode to instantly add your idle books to your digital shelf.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">🗺️</span>
        <h3>Track the Journey</h3>
        <p>It's not just a swap. Watch your book travel from person to person and see the footprint it leaves behind.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">🤝</span>
        <h3>Local Connections</h3>
        <p>Break the isolation of reading. Meet real people in your neighborhood to exchange books and ideas.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">⭐</span>
        <h3>Trusted Community</h3>
        <p>Rate and review your swap partners after a successful exchange to keep our local network safe and reliable.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">🔄</span>
        <h3>Flexible Modes</h3>
        <p>Choose to lend a book for a "Comeback" (return to you) or set it to "Drifting" (pass it on to the next reader).</p>
      </div>
    </div>
  </div>
</section>

<!-- How It Works -->
<section class="how-it-works" id="how-it-works">
  <div class="container">
    <div class="section-label">Simple Process</div>
    <h2 class="section-title">How It Works</h2>
    <div class="steps">
      <div class="step">
        <div class="step-number">1</div>
        <div>
          <h3>Discover</h3>
          <p>Browse bookshelves from users nearby.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-number">2</div>
        <div>
          <h3>Request & Connect</h3>
          <p>Send a request. Once the owner accepts, chat in-app to arrange a meetup.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-number">3</div>
        <div>
          <h3>Express Exchange</h3>
          <p>Meet offline and scan a QR code to instantly confirm the handover. Seamless and secure.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-number">4</div>
        <div>
          <h3>Start Reading</h3>
          <p>Once scanned, you become the official holder and the app tracks the book's new timeline.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-number">5</div>
        <div>
          <h3>Pass or Return</h3>
          <p>Finished? Return it to the owner, or pass it to the next waiting reader in Drifting mode.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Download CTA -->
<section class="download-cta" id="download">
  <div class="container">
    <div class="section-label">Get the App</div>
    <h2 class="section-title">Join us to make reading<br/>social, sustainable, and fun.</h2>
    <p class="section-subtitle">Download BookedAgain and start your book's journey today.</p>
    <DownloadButtons />
  </div>
</section>

<!-- Support -->
<section class="support" id="support">
  <div class="container">
    <h2 class="section-title">Support</h2>
    <div class="support-grid">
      <div class="support-card">
        <h3>✉️ Contact Us</h3>
        <p>Have questions or found a bug? We are here to help.<br/>Email: <a href="mailto:rainforest.mind.software@gmail.com">rainforest.mind.software@gmail.com</a></p>
      </div>
      <div class="support-card">
        <h3>🗑️ Account Deletion</h3>
        <p>There is an account deletion button on the account tab. If you encounter issues, email us with the subject "Delete Account" from your registered email address.</p>
      </div>
      <div class="support-card">
        <h3>🔒 Privacy Policy</h3>
        <p>Your privacy is important to us. We only collect data necessary to facilitate book swaps.<br/><a href="/privacy">Read full Privacy Policy →</a></p>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <div class="footer-inner">
    <span>© 2026 BookedAgain</span>
    <span>·</span>
    <a href="mailto:rainforest.mind.software@gmail.com">rainforest.mind.software@gmail.com</a>
    <span>·</span>
    <a href="/privacy">Privacy Policy</a>
  </div>
</footer>

</Layout>
